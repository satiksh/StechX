generator client {
  provider = "prisma-client-js"
  // Generate into the Next.js app so `@prisma/client` is initialized during `next build` on Vercel.
  output   = "../web/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
  FREELANCER
  AGENCY
}

enum AuthProvider {
  GOOGLE
  LOCAL
}

enum ApplicationType {
  CLIENT_PROJECT
  TALENT
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  DRAFT
  OPEN
  BIDDING
  BID_WON
  PENDING_ACCEPTANCE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED_REOPEN_REQUESTED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  PENDING_ADMIN_APPROVAL
  PENDING_CLIENT_APPROVAL
  ACTIVE
  AWAITING_EXTENSION
  COMPLETED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  ESCROWED
  RELEASED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  role            UserRole
  provider        AuthProvider
  providerId      String?
  avatarUrl       String?
  passwordHash    String?
  bio             String?
  skills          String[]  @default([])
  hourlyRate      Float?    // For freelancers
  totalEarnings   Float     @default(0)
  rating          Float     @default(0) // Average rating
  totalReviews    Int       @default(0)
  portfolioUrl    String?
  isVerified      Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  applications    Application[]
  jobsPosted      Job[] @relation("JobsAsClient")
  proposals       Proposal[]
  contractsAsClient Contract[] @relation("ContractAsClient")
  contractsAsFreelancer Contract[] @relation("ContractAsFreelancer")
  earnings        Earning[]
  sentMessages    Message[]    @relation("sender")
  receivedMessages Message[]   @relation("receiver")
  reviews         Review[]     @relation("reviewer")
  reviewedBy      Review[]     @relation("reviewee")
  notifications   Notification[]
  bookmarkedJobs  BookmarkedJob[]
  bids            Bid[] @relation("FreelancerBids")
  profileRating   Float     @default(0) // Separate rating for bid rejections

  @@index([email])
  @@index([role])
  @@index([isVerified])
  @@index([isSuspended])
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  title            String
  shortDescription String
  longDescription  String
  highlights       String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  projects     Project[]
  applications Application[]

  @@index([slug])
}

model Project {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  slug         String   @unique
  serviceId    String   @db.Uuid
  thumbnailUrl String
  imageUrls    String[]
  summary      String
  caseStudy    String
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  service      Service       @relation(fields: [serviceId], references: [id])
  testimonials Testimonial[]

  @@index([serviceId])
  @@index([isFeatured])
}

model Testimonial {
  id         String  @id @default(uuid()) @db.Uuid
  clientName String
  clientRole String
  quote      String
  projectId  String? @db.Uuid

  createdAt DateTime @default(now())

  // Relations
  project Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

model Application {
  id         String            @id @default(uuid()) @db.Uuid
  type       ApplicationType
  serviceId  String?           @db.Uuid
  name       String
  email      String
  message    String
  budget     Float?
  experience String?
  status     ApplicationStatus @default(SUBMITTED)
  createdAt  DateTime          @default(now())

  // Relations
  service Service? @relation(fields: [serviceId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  userId  String?  @db.Uuid

  @@index([serviceId])
  @@index([email])
  @@index([status])
  @@index([type])
}

// ===== JOB MARKETPLACE =====
model Job {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  description     String
  category        String
  requiredSkills  String[]
  budget          Float
  budgetType      String    @default("fixed") // "fixed" or "hourly" or "custom"
  customBudget    Float?    // If client enters custom budget
  maxBidPrice     Float?    // Maximum bid price (80% of budget)
  deadline        DateTime?
  status          ProjectStatus @default(OPEN)
  clientId        String    @db.Uuid
  assignedFreelancerId String? @db.Uuid
  progress        Int       @default(0) // 0-100
  attachments     String[]  @default([])
  isUrgent        Boolean   @default(false)
  biddingEndsAt   DateTime? // Bidding period ends
  rejectionCount  Int       @default(0) // Track rejections after winning bid
  lastRejectedAt  DateTime?
  weekDeadline    DateTime? // 1 week from client submission
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  client          User       @relation("JobsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  proposals       Proposal[]
  bids            Bid[]
  contract        Contract?
  messages        Message[]
  bookmarkedBy    BookmarkedJob[]
  attachmentUrls  String[]

  @@index([clientId])
  @@index([assignedFreelancerId])
  @@index([status])
  @@index([category])
  @@index([deadline])
  @@index([isUrgent])
  @@index([biddingEndsAt])
}

model Proposal {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @db.Uuid
  freelancerId    String    @db.Uuid
  coverLetter     String
  proposedBudget  Float?
  estimatedDays   Int?
  attachments     String[]  @default([])
  status          ProposalStatus @default(DRAFT)
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer     User      @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
  @@index([submittedAt])
}

model Bid {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @db.Uuid
  freelancerId    String    @db.Uuid
  bidAmount       Float
  proposedDays    Int?
  coverLetter     String?
  status          String    @default("pending") // "pending", "won", "lost", "rejected", "accepted"
  isWinner        Boolean   @default(false)
  acceptanceDeadline DateTime? // 1 day to accept after winning
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer     User      @relation("FreelancerBids", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
  @@index([isWinner])
}

model Contract {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @unique @db.Uuid
  clientId        String    @db.Uuid
  freelancerId    String    @db.Uuid
  amount          Float
  advanceAmount   Float     // Legal percentage advance payment
  advancePercentage Float   @default(30) // Default 30%
  startDate       DateTime
  endDate         DateTime?
  estimatedDays   Int?
  completionDate  DateTime?
  status          ContractStatus @default(PENDING_ADMIN_APPROVAL)
  terms           String?
  googleMeetLink  String?
  adminApprovedAt DateTime?
  clientApprovedAt DateTime?
  signedByClient  Boolean   @default(false)
  signedByFreelancer Boolean @default(false)
  extensionRequested Boolean @default(false)
  extensionReason String?
  extensionDays   Int?
  milestones      Milestone[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client          User      @relation("ContractAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancer      User      @relation("ContractAsFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  payments        Payment[]
  disputes        Dispute[]

  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@index([createdAt])
}

model Milestone {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String    @db.Uuid
  title           String
  description     String?
  amount          Float
  dueDate         DateTime
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([dueDate])
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String    @db.Uuid
  amount          Float
  type            String    @default("milestone") // "advance", "milestone", "final", "refund"
  status          PaymentStatus @default(PENDING)
  paymentMethod   String    // "stripe", "paypal", "bank_transfer"
  transactionId   String?
  description     String?
  dueDate         DateTime?
  paidAt          DateTime?
  isEscrowed      Boolean   @default(false) // Money held in escrow
  releasedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

model Earning {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  contractId      String?   @db.Uuid
  amount          Float
  type            String    // "milestone", "payment", "dispute_resolution"
  description     String?
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ===== MESSAGING =====
model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  participantIds  String[]  @db.Uuid
  jobId           String?   @db.Uuid
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  messages        Message[]

  @@index([jobId])
  @@index([lastMessageAt])
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  senderId        String    @db.Uuid
  recipientId     String    @db.Uuid
  content         String
  status          MessageStatus @default(SENT)
  attachments     String[]  @default([])
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User      @relation(name: "sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient       User      @relation(name: "receiver", fields: [recipientId], references: [id], onDelete: Cascade)
  job             Job?      @relation(fields: [jobId], references: [id])
  jobId           String?   @db.Uuid

  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
}

// ===== REVIEWS & RATINGS =====
model Review {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String?   @db.Uuid
  reviewerId      String    @db.Uuid
  revieweeId      String    @db.Uuid
  rating          Int       // 1-5
  comment         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  reviewer        User      @relation(name: "reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee        User      @relation(name: "reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([contractId, reviewerId])
  @@index([revieweeId])
  @@index([rating])
  @@index([createdAt])
}

// ===== DISPUTES =====
model Dispute {
  id              String    @id @default(uuid()) @db.Uuid
  contractId      String    @db.Uuid
  initiatedById   String    @db.Uuid
  reason          String
  description     String
  status          String    @default("open") // "open", "under_review", "resolved", "closed"
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([status])
  @@index([createdAt])
}

// ===== NOTIFICATIONS =====
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  type            String    // "job_post", "proposal", "message", "payment", etc
  title           String
  message         String
  data            Json?     // Extra context data
  read            Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ===== BOOKMARKS =====
// ===== BOOKMARKS =====
model BookmarkedJob {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  jobId           String    @db.Uuid
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

// ===== ADMIN / MODERATION =====
model Report {
  id              String    @id @default(uuid()) @db.Uuid
  reportedByUserId String   @db.Uuid
  reportedContentType String // "user", "job", "review", etc
  reportedContentId String   @db.Uuid
  reason          String
  description     String?
  status          String    @default("pending") // "pending", "investigating", "action_taken", "dismissed"
  actionTaken     String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

