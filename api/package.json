{
  "name": "stechx-backend",
  "version": "1.0.0",
  "description": "StechX Backend API - Startup for Startups",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo \"skip build on render for now\"",
  "start": "npm run prisma:generate && npx tsx src/index.ts",
  "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node ../db/seed.ts"
  },
  "keywords": [
    "stechx",
    "express",
    "typescript",
    "prisma"
  ],
  "author": "Satiksh Patel",
  "license": "MIT",
  "dependencies": {
  "@prisma/client": "5.22.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.0",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "tsx": "^4.7.0",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.25",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
  "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
